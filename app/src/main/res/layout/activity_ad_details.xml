<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".AdDetailsActivity">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="8dp"/>

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ad Details"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/backBtn"
            app:layout_constraintHorizontal_bias="0.5"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/deleteBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete_black"
                app:tint="@color/error"
                android:contentDescription="Delete Ad"
                android:visibility="gone"
                tools:visibility="visible"/>

            <ImageButton
                android:id="@+id/editBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit_white"
                app:tint="@color/teal_700"
                android:contentDescription="Edit Ad"
                android:visibility="gone"
                tools:visibility="visible"/>

            <ImageButton
                android:id="@+id/favBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_heart_outline_white"
                app:tint="@color/accent"
                android:contentDescription="Add to Favorites"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scroll content -->
    <ScrollView
        android:id="@+id/detailsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/sellerDescLabelTv">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/adImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Ad Image"
                    android:src="@drawable/ic_placeholder"/>
            </com.google.android.material.card.MaterialCardView>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/priceTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    tools:text="₹1,500"/>

                <TextView
                    android:id="@+id/statusTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/priceTv"
                    android:layout_marginStart="16dp"
                    android:layout_alignBaseline="@id/priceTv"
                    android:textSize="14sp"
                    android:textColor="@color/gray_medium"
                    tools:text="USED"/>

                <TextView
                    android:id="@+id/dateTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignBaseline="@id/priceTv"
                    android:textSize="14sp"
                    android:textColor="@color/gray_medium"
                    tools:text="02/10/2025"/>
            </RelativeLayout>

            <TextView style="@style/DetailsLabel" android:text="Category"/>
            <TextView android:id="@+id/categoryTv" style="@style/DetailsValue" tools:text="Electronics"/>

            <TextView style="@style/DetailsLabel" android:text="Title"/>
            <TextView android:id="@+id/titleTv" style="@style/DetailsValue" android:textStyle="bold" tools:text="Premium Wireless Headphones"/>

            <TextView style="@style/DetailsLabel" android:text="Description"/>
            <TextView android:id="@+id/descTv" style="@style/DetailsValue" tools:text="Gently used headphones with noise cancellation and 40-hour battery life."/>

            <TextView style="@style/DetailsLabel" android:text="Address"/>
            <TextView android:id="@+id/addressTv" style="@style/DetailsValue" tools:text="Bangalore, India"/>
        </LinearLayout>
    </ScrollView>

    <!-- Seller Section -->
    <TextView
        android:id="@+id/sellerDescLabelTv"
        style="@style/DetailsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="Seller"
        app:layout_constraintBottom_toTopOf="@id/sellerLayout"/>

    <LinearLayout
        android:id="@+id/sellerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@color/white"
        app:layout_constraintBottom_toTopOf="@id/bottomChatLayout">

        <ImageView
            android:id="@+id/sellerProfileIv"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_person_circle"
            android:scaleType="centerCrop"
            android:contentDescription="Seller Profile Picture"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/sellerNameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                tools:text="Nitin Bhandari"/>

            <TextView
                android:id="@+id/memberSinceTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/gray_medium"
                tools:text="Member since Aug 2023"/>
        </LinearLayout>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/gray_dark"
            android:contentDescription="View Seller"/>
    </LinearLayout>

    <!-- Bottom Chat Button -->
    <LinearLayout
        android:id="@+id/bottomChatLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chat with Seller"
            android:icon="@drawable/ic_chat"
            android:iconTint="@color/white"
            android:textAllCaps="false"
            android:backgroundTint="@color/teal_700"
            android:textColor="@color/white"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
